{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Afterhours: Build",
			"type": "shell",
			"command": "npm.cmd",
			"args": [
				"run",
				"build"
			],
			"isBackground": false,
			"problemMatcher": [
				"$tsc"
			],
			"group": "build"
		},
		{
			"label": "Afterhours: Dependency Repair",
			"type": "shell",
			"command": "npm",
			"args": [
				"install",
				"--force",
				"--no-audit",
				"--no-fund"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}